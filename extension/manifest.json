{
  "manifest_version": 3,
  "name": "メニューシミュレーター アシスタント",
  "name_en": "Menu Simulator Assistant",
  "version": "2.0.0",
  "description": "グルメサイトからメニュー情報を取得し、Webアプリと連携します",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],

  "host_permissions": [
    "https://tabelog.com/*",
    "https://*.tabelog.com/*",
    "https://www.hotpepper.jp/*",
    "https://*.hotpepper.jp/*",
    "https://r.gnavi.co.jp/*",
    "https://*.gnavi.co.jp/*",
    "http://localhost:3456/*",
    "https://*.workers.dev/*",
    "https://www.google.com/*",
    "<all_urls>"
  ],

  "externally_connectable": {
    "matches": [
      "https://menu-simulator.pages.dev/*",
      "http://localhost:8080/*",
      "http://127.0.0.1:8080/*",
      "http://localhost:*/*"
    ]
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/command-executor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tabelog.com/*", "https://*.tabelog.com/*"],
      "js": ["content/scraper-base.js", "content/scraper-tabelog.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hotpepper.jp/*", "https://*.hotpepper.jp/*"],
      "js": ["content/scraper-base.js", "content/scraper-hotpepper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://r.gnavi.co.jp/*", "https://*.gnavi.co.jp/*"],
      "js": ["content/scraper-base.js", "content/scraper-gnavi.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "メニューシミュレーター"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
